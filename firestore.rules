rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Catalog is managed by an admin/back office, never by client writes.
    // Any signed-in shopper can read it.
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // A user's own profile document.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // carts/{uid}/items/{productId} -- a user's cart is theirs alone.
    match /carts/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }

    // Orders are created by their owner and are immutable from the client
    // afterwards -- status transitions (confirmed/delivered/...) belong to
    // a trusted backend (e.g. Cloud Functions or an admin console), not to
    // the shopper's own device.
    match /orders/{orderId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
